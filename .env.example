# Copy to .env and replace both required secrets before starting.
POSTGRES_DB=aethera
POSTGRES_USER=aethera
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes

APP_NAME=AETHERA API
APP_ENV=development
JWT_ALGORITHM=HS256
JWT_ISSUER=aethera-api
JWT_AUDIENCE=aethera-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_OTP_PEPPER=

# Optional SMTP configuration for email OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional Firebase Admin configuration. Never commit service-account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Local browser endpoints
API_PORT=8000
WEB_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8000

# Local development demo account (disable before any public deployment)
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_EMAIL=demo@example.com
DEMO_ACCOUNT_PASSWORD=AetheraDemo!2026
DEMO_ACCOUNT_NAME=AETHERA Demo Farmer

SIMULATOR_ENABLED=#add true to enable the simulator for local development
SIMULATOR_INTERVAL=#add the interval in seconds for the simulator to run (default: 60)

