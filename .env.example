# Database
DATABASE_URL=postgresql+asyncpg://aethera:aethera_pass@localhost:5432/aethera_db

# JWT
JWT_SECRET=change-me-in-production-use-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080

# Assistant provider: stub | openai | groq
ASSISTANT_PROVIDER=stub
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional: override the provider's default model (groq: llama-3.3-70b-versatile, openai: gpt-4o-mini)
LLM_MODEL=
LLM_TIMEOUT_S=25
# Open-Meteo weather lookup for irrigation advice (free, no key)
WEATHER_ENABLED=true

# STT provider: stub | whisper
STT_PROVIDER=stub

# Demo mode (auto-generate simulated sensor data when no device)
SIMULATE_SENSORS=true

ASSISTANT_PROVIDER=groq
GROQ_API_KEY=your-key
WEATHER_ENABLED=true