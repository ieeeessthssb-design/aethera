# Copy this file to .env and provide your own local values.
APP_NAME=AETHERA API
APP_ENV=development

# Required
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/aethera
JWT_SECRET_KEY=replace-with-a-long-random-secret

# JWT configuration
JWT_ALGORITHM=HS256
JWT_ISSUER=aethera-api
JWT_AUDIENCE=aethera-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email OTP (optional; configure for production email verification)
EMAIL_OTP_PEPPER=replace-with-a-random-secret
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (optional until email delivery is enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Firebase Admin / phone authentication (optional; never commit service-account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Assistant, irrigation and voice pipeline integrations
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080
ASSISTANT_PROVIDER=stub
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_PROVIDER=stub
RAG_EMBEDDER=hash
RAG_OPENAI_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
SEED_ON_START=false
SIMULATE_SENSORS=true
